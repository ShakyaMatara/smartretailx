                }
              ]
            },
            "url": {
              "raw": "{{base_8001}}/api/v1/auth/login",
              "host": [
                "{{base_8001}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Create a product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"product identifier issued\", () => pm.expect(b.product_id).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"product_id\", b.product_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_8002}}/api/v1/products",
              "host": [
                "{{base_8002}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            },
            "description": "Administrators only. Verifies RBAC allows the permitted role.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Product\",\n  \"description\": \"Created by the API test suite\",\n  \"category\": \"postman-tests\",\n  \"price\": 24.99,\n  \"currency\": \"EUR\",\n  \"sku\": \"PM-{{$randomInt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Set stock level",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"stock recorded\", () => pm.expect(pm.response.json().available).to.eql(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_8004}}/api/v1/inventory/{{product_id}}",
              "host": [
                "{{base_8004}}"
              ],
              "path": [
                "api",
                "v1",
                "inventory",
                "{{product_id}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"{{product_id}}\",\n  \"available\": 500\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
