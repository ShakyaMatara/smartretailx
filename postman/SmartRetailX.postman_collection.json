{
  "info": {
    "_postman_id": "c0f90dff-c8f3-4755-828a-2855f5799437",
    "name": "SmartRetailX API",
    "description": "Functional and security API tests for the SmartRetailX platform.\n\nRun with Newman:\n  newman run postman/SmartRetailX.postman_collection.json \\\n    -e postman/SmartRetailX.postman_environment.json \\\n    -r cli,html\n\nFolders execute in order. Setup issues the tokens that later folders depend on, so the collection must be run as a whole rather than as individual requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Setup",
      "description": "Authenticates and seeds the data used by later folders.",
      "item": [
        {
          "name": "Login as administrator",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"returns a bearer token pair\", () => {",
                  "  pm.expect(b).to.have.property(\"access_token\");",
                  "  pm.expect(b).to.have.property(\"refresh_token\");",
                  "  pm.expect(b.token_type).to.eql(\"bearer\");",
                  "});",
                  "pm.test(\"access token is short-lived\", () =>",
                  "  pm.expect(b.expires_in).to.be.at.most(900));",
                  "pm.collectionVariables.set(\"admin_token\", b.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{admin_email}}"
                },
                {
                  "key": "password",
                  "value": "{{admin_password}}"
                }
              ]
            },
            "url": {
              "raw": "{{base_8001}}/api/v1/auth/login",
              "host": [
                "{{base_8001}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "OAuth 2.0 password grant. Stores the access token for reuse."
          }
        },
        {
          "name": "Register a customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"role defaults to customer\", () => pm.expect(b.role).to.eql(\"customer\"));",
                  "pm.test(\"no credential material returned\", () => {",
                  "  pm.expect(b).to.not.have.property(\"password\");",
                  "  pm.expect(b).to.not.have.property(\"password_hash\");",
                  "});",
                  "pm.collectionVariables.set(\"customer_email\", b.email);",
                  "pm.collectionVariables.set(\"customer_id\", b.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_8001}}/api/v1/users/register",
              "host": [
                "{{base_8001}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "register"
              ]
            },
            "description": "Role is assigned by the server; a role supplied by the client is ignored.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{$guid}}@example.com\",\n  \"full_name\": \"Postman Customer\",\n  \"password\": \"PostmanPassword2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login as customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"customer_token\", pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{customer_email}}"
                },
                {
                  "key": "password",
