    {
      "name": "2 Functional",
      "description": "Core behaviour of each service.",
      "item": [
        {
          "name": "Read own profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns the caller\", () =>",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"customer_id\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_8001}}/api/v1/users/me",
              "host": [
                "{{base_8001}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "List products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));",
                  "pm.test(\"respects the limit\", () => pm.expect(pm.response.json().length).to.be.at.most(25));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_8002}}/api/v1/products?limit=25",
              "host": [
                "{{base_8002}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "25"
                }
              ]
            },
            "description": "Public endpoint. Pagination prevents unbounded responses."
          }
        },
        {
          "name": "Filter products by category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"all results match the filter\", () =>",
                  "  pm.response.json().forEach(p => pm.expect(p.category).to.eql(\"postman-tests\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_8002}}/api/v1/products?category=postman-tests&limit=25",
              "host": [
                "{{base_8002}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "postman-tests"
                },
                {
                  "key": "limit",
                  "value": "25"
                }
              ]
            },
            "description": "Served by an indexed query against the DynamoDB secondary index."
          }
        },
        {
          "name": "Get a single product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"identifier matches\", () =>",
                  "  pm.expect(pm.response.json().product_id).to.eql(pm.collectionVariables.get(\"product_id\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_8002}}/api/v1/products/{{product_id}}",
              "host": [
                "{{base_8002}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{product_id}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Check stock",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"stock fields present\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.available).to.be.a(\"number\");",
                  "  pm.expect(b.reserved).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_8004}}/api/v1/inventory/{{product_id}}",
              "host": [
                "{{base_8004}}"
              ],
              "path": [
                "api",
                "v1",
                "inventory",
                "{{product_id}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Place an order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"accepted as PENDING\", () => pm.expect(b.status).to.eql(\"PENDING\"));",
                  "pm.test(\"total is calculated server-side\", () =>",
                  "  pm.expect(Number(b.total_amount)).to.eql(Number(b.items[0].unit_price) * 2));",
                  "pm.test(\"correlation id returned\", () =>",
                  "  pm.expect(pm.response.headers.get(\"x-correlation-id\")).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"order_id\", b.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "pm-{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_8003}}/api/v1/orders",
              "host": [
                "{{base_8003}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "description": "Returns 201 before the saga completes; state advances asynchronously.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_id\": \"{{product_id}}\",\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Wait for the saga, then read the order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 0);",
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"reached a terminal saga state\", () =>",
                  "  pm.expect([\"CONFIRMED\", \"CANCELLED\", \"STOCK_RESERVED\", \"PENDING\"]).to.include(b.status));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_8003}}/api/v1/orders/{{order_id}}",
              "host": [
                "{{base_8003}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{order_id}}"
              ]
            },
            "description": "Polled after a delay: the saga completes asynchronously."
          }
        },
        {
          "name": "List own orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test('only the caller orders are returned', () =>",
                  "  pm.response.json().forEach(o =>",
                  "    pm.expect(o.user_id).to.eql(pm.collectionVariables.get(\"customer_id\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_8003}}/api/v1/orders",
              "host": [
                "{{base_8003}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "description": ""
          }
        }
      ]
    },
